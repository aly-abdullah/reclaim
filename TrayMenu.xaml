<Window x:Class="Reclaim.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Reclaim.Controls"
        Title="Reclaim" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000" Opacity="0"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}" FontSize="13"
        UseLayoutRounding="True">
    <Border Margin="16" Width="276" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="6">
            <Grid Margin="10,10,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <c:RingGauge x:Name="Ring" Width="40" Height="40" StrokeThickness="5"
                             TrackBrush="{StaticResource Surface3Brush}" ArcBrush="{StaticResource AccentGradient}"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PercentText" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource Divider}" Margin="4,0,4,6"/>

            <Button x:Name="ReclaimItem" Style="{StaticResource MenuItemButton}" Click="OnReclaim">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Foreground="{StaticResource Accent2Brush}" FontSize="14" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Reclaim memory now" FontWeight="SemiBold" Margin="6,0,0,0"/>
                </Grid>
            </Button>
            <Button Style="{StaticResource MenuItemButton}" Click="OnOpen">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Open Reclaim" Margin="6,0,0,0"/>
                </Grid>
            </Button>
            <Button x:Name="PauseItem" Style="{StaticResource MenuItemButton}" Click="OnPause">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PauseIcon" Style="{StaticResource Icon}" Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PauseText" Grid.Column="1" Margin="6,0,0,0"/>
                </Grid>
            </Button>

            <Border Style="{StaticResource Divider}" Margin="4,6"/>

            <Button Style="{StaticResource MenuItemButton}" Click="OnQuit">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" Foreground="#FF8A8E" FontSize="14" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Quit Reclaim" Margin="6,0,0,0"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
