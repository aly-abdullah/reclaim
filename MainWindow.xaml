<Window x:Class="Reclaim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Reclaim.Controls"
        Title="Reclaim" Width="1060" Height="690"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="/Assets/Reclaim.ico" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="Transparent">
        <Ellipse Width="760" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-330,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E7C6CFF" Offset="0"/>
                    <GradientStop Color="#007C6CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="700" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-320,-320" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1C2BD4E8" Offset="0"/>
                    <GradientStop Color="#002BD4E8" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="22,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Reclaim" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Margin="11,0,0,1" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Badge}" Margin="12,1,0,0">
                        <TextBlock Text="Memory optimizer" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource StatusPill}" Command="{Binding TogglePauseCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Pause or resume automatic cleaning">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource StatusDot}" Opacity="0.35" Width="14" Height="14" Margin="-3"/>
                                <Ellipse Style="{StaticResource StatusDot}"/>
                            </Grid>
                            <TextBlock Text="{Binding StatusText}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" Margin="14,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"/>
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnClose" Margin="4,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="22,2,22,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="396"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="26,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="190" Height="190">
                                <c:RingGauge x:Name="Ring" StrokeThickness="14" TrackBrush="{StaticResource Surface3Brush}" ArcBrush="{StaticResource AccentGradient}">
                                    <c:RingGauge.Effect>
                                        <DropShadowEffect x:Name="RingGlow" Color="#7C6CFF" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                                    </c:RingGauge.Effect>
                                </c:RingGauge>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding UsedPercent}" FontFamily="{StaticResource DisplayFont}" FontSize="50" FontWeight="SemiBold"/>
                                        <TextBlock Text="%" FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,11" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="memory in use" HorizontalAlignment="Center" Style="{StaticResource Caption}" Margin="0,-6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Physical memory" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Row="1" Margin="0,3,0,0">
                                    <Run Text="{Binding InUseText, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                                    <Run Text=" of " Foreground="{StaticResource MutedBrush}" FontSize="15"/>
                                    <Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="15"/>
                                </TextBlock>

                                <c:CompositionBar x:Name="Bar" Grid.Row="2" Height="10" Margin="0,14,0,0"/>

                                <UniformGrid Grid.Row="3" Columns="4" Margin="0,16,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource InUseBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="In use" Style="{StaticResource Caption}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InUseText}" Style="{StaticResource Metric}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource ModifiedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Modified" Style="{StaticResource Caption}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Metric}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource StandbyBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Standby" Style="{StaticResource Caption}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StandbyText}" Style="{StaticResource Metric}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource FreeBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Free" Style="{StaticResource Caption}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Metric}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Grid Grid.Row="5" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanNowCommand}" MinWidth="160">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCleaning}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="15"/>
                                                <TextBlock Text="Reclaim now" Margin="9,0,0,1" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        Visibility="{Binding IsCleaning, Converter={StaticResource BoolVis}}">
                                                <Ellipse Width="16" Height="16" Stroke="White" StrokeThickness="2" StrokeDashArray="9 4" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform x:Name="SpinnerRotation"/>
                                                    </Ellipse.RenderTransform>
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <TextBlock Text="Reclaiming&#x2026;" Margin="9,0,0,1" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Grid x:Name="ResultPanel" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="ResultShift"/>
                                        </Grid.RenderTransform>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource FreeSoftBrush}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource FreeBrush}" FontSize="12"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResultHeadline}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultHeadline}"/>
                                            <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultDetail}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="26,22,26,22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Activity" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Last 3 minutes, share of total memory" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Border Width="14" Height="3" CornerRadius="1.5" Background="{StaticResource InUseBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="In use" Style="{StaticResource Caption}" Margin="7,0,16,0"/>
                                    <Border Width="14" Height="3" CornerRadius="1.5" Background="{StaticResource StandbyBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Standby" Style="{StaticResource Caption}" Margin="7,0,16,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource FreeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clean" Style="{StaticResource Caption}" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,14,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <c:ActivityChart x:Name="Chart"/>
                                <Grid Grid.Column="1" Margin="0,0,0,0">
                                    <TextBlock Text="100%" Style="{StaticResource Caption}" FontSize="10.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,0,0"/>
                                    <TextBlock Text="50%" Style="{StaticResource Caption}" FontSize="10.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Text="0%" Style="{StaticResource Caption}" FontSize="10.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-1"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" Style="{StaticResource Divider}" VerticalAlignment="Top"/>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Cleans performed" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding CleanCountText}" Style="{StaticResource Metric}" FontSize="19" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,16,0,0">
                                    <TextBlock Text="Total reclaimed" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding TotalReclaimedText}" Style="{StaticResource Metric}" FontSize="19" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,16,0,0">
                                    <TextBlock Text="Last clean" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding LastCleanText}" Style="{StaticResource Metric}" FontSize="19" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SegmentFrame}">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="TabAutomation" Style="{StaticResource SegmentRadio}" Content="Automation" GroupName="Tabs" IsChecked="True"/>
                                <RadioButton x:Name="TabCleaning" Style="{StaticResource SegmentRadio}" Content="Cleaning" GroupName="Tabs"/>
                                <RadioButton x:Name="TabGeneral" Style="{StaticResource SegmentRadio}" Content="General" GroupName="Tabs"/>
                            </UniformGrid>
                        </Border>

                        <Grid Grid.Row="1" Margin="4,24,4,2">

                            <StackPanel Style="{StaticResource FadePanel}" Visibility="{Binding IsChecked, ElementName=TabAutomation, Converter={StaticResource BoolVis}}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScheduleEnabled}">
                                    <StackPanel>
                                        <TextBlock Text="Clean on a schedule" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Purge memory automatically at a fixed interval." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <StackPanel Style="{StaticResource Dimmable}" IsEnabled="{Binding ScheduleEnabled}" Margin="0,16,0,0">
                                    <Grid>
                                        <Border Style="{StaticResource StepperFrame}" Width="176" HorizontalAlignment="Left">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <RepeatButton Style="{StaticResource StepperButton}" Content="&#xE738;" Command="{Binding IntervalDownCommand}" ToolTip="Shorter interval"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBox Style="{StaticResource StepperBox}" MinWidth="22" Text="{Binding IntervalMinutes, UpdateSourceTrigger=Explicit}"/>
                                                    <TextBlock Text="min" Style="{StaticResource Caption}" Margin="5,1,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <RepeatButton Grid.Column="2" Style="{StaticResource StepperButton}" Content="&#xE710;" Command="{Binding IntervalUpCommand}" ToolTip="Longer interval"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Next clean" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding NextCleanText}" Style="{StaticResource Metric}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Intervals" Content="15 min" IsChecked="{Binding IntervalMinutes, Converter={StaticResource IntEquals}, ConverterParameter=15}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Intervals" Content="30 min" IsChecked="{Binding IntervalMinutes, Converter={StaticResource IntEquals}, ConverterParameter=30}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Intervals" Content="1 hour" IsChecked="{Binding IntervalMinutes, Converter={StaticResource IntEquals}, ConverterParameter=60}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Intervals" Content="2 hours" IsChecked="{Binding IntervalMinutes, Converter={StaticResource IntEquals}, ConverterParameter=120}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Intervals" Content="4 hours" IsChecked="{Binding IntervalMinutes, Converter={StaticResource IntEquals}, ConverterParameter=240}"/>
                                    </WrapPanel>
                                </StackPanel>

                                <Border Style="{StaticResource Divider}" Margin="0,16,0,20"/>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ThresholdEnabled}">
                                    <StackPanel>
                                        <TextBlock Text="Clean at a memory limit" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Purge the moment memory crosses a size you choose." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <StackPanel Style="{StaticResource Dimmable}" IsEnabled="{Binding ThresholdEnabled}" Margin="0,16,0,0">
                                    <Border Style="{StaticResource SegmentFrame}">
                                        <UniformGrid Columns="2">
                                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Metric" Content="Standby reaches" IsChecked="{Binding ThresholdIsStandby}"/>
                                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Metric" Content="Free drops to" IsChecked="{Binding ThresholdIsFree}"/>
                                        </UniformGrid>
                                    </Border>
                                    <Grid Margin="0,12,0,0">
                                        <Border Style="{StaticResource StepperFrame}" Width="176" HorizontalAlignment="Left">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <RepeatButton Style="{StaticResource StepperButton}" Content="&#xE738;" Command="{Binding ThresholdDownCommand}" ToolTip="Lower limit"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBox Style="{StaticResource StepperBox}" MinWidth="22" Text="{Binding ThresholdGb, StringFormat=0.0, UpdateSourceTrigger=Explicit}"/>
                                                    <TextBlock Text="GB" Style="{StaticResource Caption}" Margin="5,1,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <RepeatButton Grid.Column="2" Style="{StaticResource StepperButton}" Content="&#xE710;" Command="{Binding ThresholdUpCommand}" ToolTip="Higher limit"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Right now" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ThresholdLiveText}" Style="{StaticResource Metric}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="Checked every second. If a clean can't free anything, Reclaim backs off on its own instead of looping."/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Style="{StaticResource FadePanel}" Visibility="{Binding IsChecked, ElementName=TabCleaning, Converter={StaticResource BoolVis}}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CleanStandby}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Standby list" Style="{StaticResource SectionTitle}"/>
                                            <Border CornerRadius="6" Padding="6,1" Margin="8,0,0,0" Background="{StaticResource FreeSoftBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="Recommended" FontSize="10.5" Foreground="{StaticResource FreeBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Cached pages Windows keeps around after apps close. Safe to purge; Windows rebuilds it on demand." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" Margin="0,18"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CleanModified}">
                                    <StackPanel>
                                        <TextBlock Text="Modified page list" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Writes pending changes to disk, then frees those pages." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" Margin="0,18"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CleanWorkingSets}">
                                    <StackPanel>
                                        <TextBlock Text="Process working sets" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Trims every app's memory. Frees the most, but apps may feel sluggish for a moment." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" Margin="0,18"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CleanFileCache}">
                                    <StackPanel>
                                        <TextBlock Text="System file cache" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Releases the file system cache's working set." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="{Binding NoticeText}" Foreground="#FF8A8E" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <DockPanel Style="{StaticResource FadePanel}" Visibility="{Binding IsChecked, ElementName=TabGeneral, Converter={StaticResource BoolVis}}">
                                <Grid DockPanel.Dock="Bottom">
                                    <Border Style="{StaticResource Divider}" VerticalAlignment="Top"/>
                                    <StackPanel Margin="0,16,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Reclaim" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource DangerGhostButton}" Command="{Binding QuitCommand}" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="12"/>
                                            <TextBlock Text="Quit Reclaim" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RunAtStartup}">
                                        <StackPanel>
                                            <TextBlock Text="Launch at sign-in" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Starts with Windows, elevated, without a UAC prompt." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartSilently}" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Start quietly in the tray" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="At sign-in, skip the window and go straight to the tray." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Minimize to tray" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Minimizing hides Reclaim from the taskbar." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Close to tray" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Keep cleaning in the background after closing the window." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Notifications}" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Show how much was reclaimed after automatic cleans." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="{Binding NoticeText}" Foreground="#FF8A8E" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
